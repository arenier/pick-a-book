{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    // The adapter specs import their recorded provider answers directly, so tsc has to be
    // allowed to read a .json as a module (ADR 0005: replayed responses, no network).
    "resolveJsonModule": true
  },
  "include": [
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/**/recorded/*.json"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
