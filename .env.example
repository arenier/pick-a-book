# API configuration — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is ignored by git. No real secret belongs in this file.
# Variables marked REQUIRED fail the API startup when missing (validation lives in
# apps/api/src/config/environment.ts).


# --- Runtime ------------------------------------------------------------------

# development | test | production. Default: development.
NODE_ENV=development

# Port the API listens on. Default: 3000.
# In production, Cloud Run imposes the value through this variable (ADR 0004).
PORT=3000


# --- Persistence (ADR 0006) ----------------------------------------------------

# REQUIRED. Path to the SQLite file.
# In production, a path on the bucket mounted as a gcsfuse volume. ADR 0006 reminder:
# the Cloud Run revision has to run with `max-instances=1` — a second writer corrupts the
# database. This is not a scaling setting, it is an integrity constraint.
DATABASE_PATH=./.data/pick-a-book.sqlite


# --- Object storage (ADR 0004) -------------------------------------------------

# REQUIRED. Bucket holding the shelf photos.
STORAGE_BUCKET=pick-a-book-photos

# Object storage emulator for local development. Leave empty in production.
# The docker-compose stack provides fake-gcs-server on this endpoint.
STORAGE_EMULATOR_HOST=http://localhost:4443


# --- Recognition (ADR 0005) ----------------------------------------------------

# VLM provider key. Optional as long as the active adapter is the stub
# (StubShelfScannerAdapter); required the day the real adapter is wired in.
# Never commit a real value here.
SHELF_SCANNER_API_KEY=
