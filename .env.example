# API configuration — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is ignored by git. No real secret belongs in this file.
# Variables marked REQUIRED fail the API startup when missing (validation lives in
# apps/api/src/config/environment.ts).


# --- Runtime ------------------------------------------------------------------

# development | test | production. Default: development.
NODE_ENV=development

# Port the API listens on. Default: 3000.
# In production, Cloud Run imposes the value through this variable (ADR 0004).
PORT=3000


# --- Persistence (ADR 0006) ----------------------------------------------------

# REQUIRED. Postgres connection string, `postgres://` or `postgresql://` — the startup
# refuses anything else.
# In production it is the Neon endpoint, held in Secret Manager under this same name and
# injected by Cloud Run (`infra/envs/prod/main.tf`); Terraform fills that secret from the
# Neon module rather than by hand, so the value never transits the state.
# Locally, the Postgres of the docker-compose stack — port 5433, not 5432: the stack
# publishes it there to avoid colliding with a Postgres already installed on the host.
# Never commit a real value here.
DATABASE_URL=postgresql://pick_a_book:pick_a_book@localhost:5433/pick_a_book


# --- Object storage (ADR 0004) -------------------------------------------------

# REQUIRED. Bucket holding the shelf photos.
STORAGE_BUCKET=pick-a-book-photos

# Object storage emulator for local development. Leave empty in production.
# The docker-compose stack provides fake-gcs-server on this endpoint.
STORAGE_EMULATOR_HOST=http://localhost:4443


# --- Recognition (ADR 0005) ----------------------------------------------------

# Which VLM answers a scan: gemini | qwen | stub. Default: stub.
#
# `stub` calls nothing and needs no key — it is what lets the API boot, and the frontend be
# worked on, without a key or a bill. Selecting a real provider makes ITS key required, and
# only its key: the startup fails with the name of the one that is missing.
SHELF_SCANNER_PROVIDER=stub

# Google AI Studio key. REQUIRED when SHELF_SCANNER_PROVIDER=gemini.
# Never commit a real value here.
GEMINI_API_KEY=

# OpenRouter key. REQUIRED when SHELF_SCANNER_PROVIDER=qwen.
# OpenRouter rather than DashScope: DashScope requires an Alibaba Cloud account with identity
# verification even on its free tier (issue #10).
# Never commit a real value here.
OPENROUTER_API_KEY=
