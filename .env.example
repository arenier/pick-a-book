# Configuration de l'API — copier en `.env` et adapter.
#
#   cp .env.example .env
#
# `.env` est ignore par git. Aucun secret reel ne doit entrer dans ce fichier-ci.
# Les variables marquees REQUISE font echouer le demarrage de l'API si elles manquent
# (validation dans apps/api/src/config/environment.ts).


# --- Execution ---------------------------------------------------------------

# development | test | production. Defaut : development.
NODE_ENV=development

# Port d'ecoute de l'API. Defaut : 3000.
# En production, Cloud Run impose la valeur par cette variable (ADR 0004).
PORT=3000


# --- Persistance (ADR 0006) ---------------------------------------------------

# REQUISE. Chemin du fichier SQLite.
# En production, un chemin sur le bucket monte en volume gcsfuse. Rappel de l'ADR 0006 :
# la revision Cloud Run doit tourner en `max-instances=1` — un second ecrivain corrompt
# la base. Ce n'est pas un reglage d'echelle, c'est une contrainte d'integrite.
DATABASE_PATH=./.data/pick-a-book.sqlite


# --- Stockage objet (ADR 0004) ------------------------------------------------

# REQUISE. Bucket des photos d'etagere.
STORAGE_BUCKET=pick-a-book-photos

# Emulateur de stockage objet pour le developpement local. A laisser vide en production.
# Le docker-compose fournit fake-gcs-server sur ce point d'entree.
STORAGE_EMULATOR_HOST=http://localhost:4443


# --- Reconnaissance (ADR 0005) ------------------------------------------------

# Cle du fournisseur de VLM. Optionnelle tant que l'adaptateur actif est le bouchon
# (StubShelfScannerAdapter) ; requise le jour ou l'adaptateur reel est branche.
# Ne jamais commiter de valeur reelle ici.
SHELF_SCANNER_API_KEY=
