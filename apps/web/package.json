{
  "name": "@pick-a-book/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "vite"
            ]
          },
          {
            "env": "VITE_API_BASE_URL"
          }
        ]
      },
      "translations": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "i18next-cli status",
            "i18next-cli lint"
          ],
          "parallel": false
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/i18next.config.ts",
          {
            "externalDependencies": [
              "i18next-cli"
            ]
          }
        ]
      }
    },
    "tags": [
      "type:app",
      "scope:web"
    ]
  },
  "dependencies": {
    "@pick-a-book/shared-i18n": "workspace:*",
    "@pick-a-book/shared-ui": "workspace:*"
  }
}
