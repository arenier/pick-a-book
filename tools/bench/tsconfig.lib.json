{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["es2023"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/shared/text-match/tsconfig.lib.json"
    },
    {
      "path": "../../libs/recognition/infrastructure/tsconfig.lib.json"
    },
    {
      "path": "../../libs/recognition/domain/tsconfig.lib.json"
    }
  ],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
